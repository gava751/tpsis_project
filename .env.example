# --- Серверное приложение (server_app) ---
# Подключение к СУБД MySQL (по умолчанию, как спроектировано в ЛР7):
DB_URL=mysql+pymysql://santa:santa@localhost:3306/santa_promo?charset=utf8mb4
# Для быстрого локального запуска без MySQL можно использовать SQLite:
# DB_URL=sqlite:///./santa_promo.db

# Адрес ML-сервиса и ERP-системы (UC-3, UC-8, UC-9)
ML_SERVICE_URL=http://127.0.0.1:8001
ERP_BASE_URL=http://127.0.0.1:8002

# JWT (UC-1)
JWT_SECRET=santa-promo-predictor-development-secret-key-32b
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# Порт серверного приложения
SERVER_PORT=8000

# --- ML-сервис (ml_service) ---
ML_PORT=8001
# Каталог хранения версий моделей (реестр моделей)
MODEL_REGISTRY_DIR=./models

# --- Заглушка ERP (erp_mock) ---
ERP_PORT=8002
